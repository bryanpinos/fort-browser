# Fort Parent settings. Copy to .env (chmod 600). Guide: docs/parent-console.md.
# The console's address. Passkeys are tied to this name, so pick it once.
RP_ID=parent.example.com
ORIGIN=https://parent.example.com
# The relay stack folder (this console reads its review/ and edits its config/).
RELAY_DIR=/srv/fort-relay
PARENT_PORT=8094
# One entry per kid: an id for URLs, a display name, the device ID in their
# relay certificate, and their Fort Chat user name (if you run Fort Chat).
KIDS=[{"id":"kid1","name":"Kid One","device":"kid1-ipad","chat_user":"Kid One"}]
# Optional: the kids' Open WebUI and an admin API key for it (shows their chats).
OWUI_URL=
OWUI_KEY=
# Optional: Home Assistant's address, so the console can be shown in its sidebar.
HA_ORIGIN=
