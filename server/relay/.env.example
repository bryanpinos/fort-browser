# Fort relay settings. Copy to .env (chmod 600) and fill in. Guide: docs/relay.md.

# ---- Required ---------------------------------------------------------------
# The relay's public name (what Fort's "Relay host" setting points at).
RELAY_DOMAIN=relay.example.com
# Your own internal domains: the relay refuses to tunnel to them (space-separated).
INTERNAL_DOMAINS=example.com
# Optional components to run (comma-separated): route53, review, monitoring, chat, unifi
COMPOSE_PROFILES=
# Plain Docker network (default), or add the VLAN overlay (recommended):
# COMPOSE_FILE=docker-compose.yaml:docker-compose.vlan.yaml
RELAY_PORT=8443

# ---- Profile "route53": Let's Encrypt cert + dynamic DNS via Route 53 -------
LEGO_EMAIL=you@example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_HOSTED_ZONE_ID=

# ---- Profiles "monitoring" and "review": Home Assistant over MQTT -----------
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
# "review": an OpenAI-compatible endpoint (e.g. LM Studio) and model.
LLM_URL=http://192.0.2.20:1234/v1/chat/completions
LLM_MODEL=gemma-4-31b-it
REVIEW_SUMMARY_AT=19:30
REVIEW_RETENTION_DAYS=30
# Age the model judges pages for (one value for all iPads).
REVIEW_CHILD_AGE=9

# ---- Profile "chat": search and page reader for Fort Chat -------------------
# Shown to sites the page reader visits and to Wikipedia (their API asks for it).
CONTACT_EMAIL=you@example.com
SEARXNG_SECRET=            # openssl rand -hex 32
# The host running Fort Chat (Open WebUI): the only client allowed to use kids-fetch.
FETCH_ALLOWED_CLIENTS=192.0.2.20
KIDS_SEARCH_PORT=8081
KIDS_FETCH_PORT=8082

# Fort Chat through the relay (optional): the name the iPads use and a fixed
# address of the reverse proxy in front of the kids' Open WebUI. That proxy
# must refuse every other host to requests from the relay (docs/fort-chat.md).
KIDS_CHAT_HOST=
KIDS_CHAT_UPSTREAM_IP=
KIDS_CHAT_UPSTREAM_PORT=443

# ---- Profile "unifi" ---------------------------------------------------------
SINKHOLE_IP=203.0.113.250

# ---- VLAN overlay (docker-compose.vlan.yaml) ---------------------------------
VLAN_PARENT=eth0.40
VLAN_SUBNET=192.168.40.0/24
VLAN_GATEWAY=192.168.40.1
VLAN_IP_RANGE=192.168.40.8/29
RELAY_IP=192.168.40.10
RELAY_MAC=02:46:6f:72:74:0a
KIDS_SEARCH_IP=192.168.40.11
KIDS_SEARCH_MAC=02:46:6f:72:74:0b
KIDS_FETCH_IP=192.168.40.12
KIDS_FETCH_MAC=02:46:6f:72:74:0c
